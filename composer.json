{
    "name": "mnb/mnb-phpexcel-xls",
    "description": "Fully independent native BIFF8 XLS reader and writer for MNB PHPExcel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-iconv": "*",
        "mnb/mnb-phpexcel-core": "^2.0.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Mnb\\PHPExcel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mnb\\PHPExcel\\Xls\\Tests\\": "tests/"
        }
    },
    "conflict": {
        "mnb/mnb-phpexcel": "*"
    }
}
