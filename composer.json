{
    "name": "mnb/mnb-phpexcel-xls",
    "description": "Optional legacy XLS reader adapter for MNB PHPExcel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "mnb/mnb-phpexcel-core": "^1.2",
        "phpoffice/phpspreadsheet": "^2.1 || ^3.3 || ^4.0 || ^5.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Mnb\\PHPExcel\\": "src/"
        }
    },
    "conflict": {
        "mnb/mnb-phpexcel": "*"
    }
}
